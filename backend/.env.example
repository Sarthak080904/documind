# https://aistudio.google.com/apikey  (free tier)
GOOGLE_API_KEY=your_key_here

# Comma-separated origins allowed to call this API. Leave BLANK for local
# development — any localhost port is then accepted, so Vite falling back to
# 5174 doesn't look like a dead backend. Set it in production to your real
# frontend URL, e.g. https://documind.vercel.app
ALLOWED_ORIGINS=

# Where Chroma + the document index live. Use a Render disk in production.
DATA_DIR=./data
